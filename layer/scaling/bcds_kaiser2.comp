#version 450
#extension GL_GOOGLE_include_directive : require
// Ported to GLSL in 2026 from OptiScaler/shaders/output_scaling/precompile/bcds_kaiser2.hlsl
// in OptiScaler (GPL-3.0; see PROVENANCE.md).

#include "bcds_window.glsl"

const float A_KAISER = 2.0;

// Post-TAA friendly default. Expose as a constant/CB if you want.
const float BETA = 5.0;

const float SUPPORT = A_KAISER;

// 1 / I0(BETA) is a constant, which the compiler folds.
float Weight(float x)
{
    return Kaiser(x, A_KAISER, BETA, 1.0 / I0(BETA));
}

#include "bcds.glsl"
