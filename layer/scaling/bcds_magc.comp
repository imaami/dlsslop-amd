#version 450
#extension GL_GOOGLE_include_directive : require
// Ported to GLSL in 2026 from OptiScaler/shaders/output_scaling/precompile/bcds_magc.hlsl
// in OptiScaler (GPL-3.0; see PROVENANCE.md).

float MagicKernel(float x)
{
    float ax = abs(x);
    if (ax >= 1.5)
        return 0.0;

    if (x <= -0.5)
    {
        float t = x + 1.5;
        return 0.5 * t * t;
    }
    else if (x < 0.5)
    {
        return 0.75 - x * x;
    }
    else
    {
        float t = x - 1.5;
        return 0.5 * t * t;
    }
}

const float R = 1.5;

const float SUPPORT = R;

float Weight(float x)
{
    return MagicKernel(x);
}

// As upstream: the taps outside the image are left out and the rest
// renormalised, and there is no min/max clamp.
#define TRUNCATE
#define NO_CLAMP
#include "bcds.glsl"
