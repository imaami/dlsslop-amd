#!/usr/bin/bash
# Steam launch options: /home/USER/.local/bin/dlsslop-run -- %command%

usage_line='Usage: dlsslop-run [OPTIONS] [--] COMMAND [ARGUMENTS...]'
declare -A option_variable=([-s]=channel [--shm]=channel [-l]=log [--log]=log)
channel_default=${DLSSNR_SHM:-/tmp/dlsslop-amd-${UID}/shm.bin}
[[ $channel_default == /* ]] || channel_default=$PWD/$channel_default
channel=$channel_default
log=${DLSSNR_LOG:-}
# The layer manifest installed beside this launcher; the Vulkan loader does not
# search every prefix (/opt/dlsslop-amd, say) by itself.
self=$(readlink -f -- "${BASH_SOURCE[0]}")
layers=${self%/bin/*}/share/vulkan/implicit_layer.d
[[ -d $layers ]] || layers=

fail() {
    printf '%s\n' "$2" >&2
    exit "$1"
}

usage() {
    cat <<HELP
${usage_line}
Run a game with the native AMD presentation layer and a native worker.

Options:
  -s, --shm PATH   Worker channel (default: ${channel_default}).
  -l, --log PATH   Layer log (default: ${DLSSNR_LOG:-${channel_default%/*}/layer.log}).
  -h, --help       Show this help and exit (default: off).
  --              End launcher options (default: first COMMAND ends options).

Environment defaults:
  DLSSNR_SHM      /tmp/dlsslop-amd-\$UID/shm.bin (UID=${UID}); --shm overrides it.
  DLSSNR_LOG      <channel directory>/layer.log; --log overrides it.
Relative paths are resolved against the launcher's working directory.

The launcher sets these values for COMMAND, overriding inherited values:
  DLSSLOP_AMD_ENABLE=1  DLSSNR_ENABLE=1  DLSSNR_IDLE_REPAINT=0
It prepends the installation's layer manifests to VK_ADD_IMPLICIT_LAYER_PATH
(${layers:-none: no share/vulkan/implicit_layer.d beside this launcher}).
It unsets DLSSNR_DISABLE and VKLayer_DLSS5. Other environment is inherited.
COMMAND and its arguments are passed unchanged; its exit status is preserved.
Start dlsslopd first, or let systemd start it: with no worker serving the
channel, the launcher connects to the socket beside it (dlsslop.socket) and
waits up to 60 s for the worker it starts.
HELP
}

while (( $# )); do
    case $1 in
        -h|--help) usage; exit 0 ;;
        --shm=*|--log=*) set -- "${1%%=*}" "${1#*=}" "${@:2}" ;;
        -s?*|-l?*) set -- "${1:0:2}" "${1:2}" "${@:2}" ;;
        -s|--shm|-l|--log)
            [[ $2 ]] || fail 2 "dlsslop-run: $1 requires a nonempty path"
            printf -v "${option_variable[$1]}" '%s' "$2"
            shift 2 ;;
        --) shift; break ;;
        -*) fail 2 "dlsslop-run: unknown option: $1 (see --help)" ;;
        *) break ;;
    esac
done
(( $# )) || fail 2 "$usage_line"
[[ $channel == /* ]] || channel=$PWD/$channel
log=${log:-${channel%/*}/layer.log}
[[ $log == /* ]] || log=$PWD/$log
command -v flock >/dev/null 2>&1 || fail 1 'dlsslop-run requires flock (Debian package util-linux).'
# 73: a worker holds the channel's lock; 0: nobody does; 1: no channel yet.
serving() {
    [[ -f $channel ]] || return 1
    flock --nonblock --conflict-exit-code 73 "$channel" true
}
serving
status=$?
if (( status != 73 )) && [[ -S $channel.sock ]]; then
    # Connecting starts a socket-activated worker; it closes the connection
    # once it serves, so EOF means ready.
    python3 - "$channel.sock" <<'PROBE'
import socket, sys
probe = socket.socket(socket.AF_UNIX, socket.SOCK_SEQPACKET)
probe.settimeout(60)
try:
    probe.connect(sys.argv[1])
    probe.shutdown(socket.SHUT_WR)
    probe.recv(1)
except OSError:
    sys.exit(1)
PROBE
    serving
    status=$?
fi
case $status in
    73) ;;
    1) fail 1 "Start dlsslopd on the host first (missing $channel)." ;;
    0) fail 1 'No live native worker owns this channel; start dlsslopd first.' ;;
    *) fail 1 'Could not inspect the native worker channel.' ;;
esac
export DLSSNR_SHM=$channel DLSSNR_LOG=$log DLSSLOP_AMD_ENABLE=1 DLSSNR_ENABLE=1 DLSSNR_IDLE_REPAINT=0
[[ $layers ]] && export VK_ADD_IMPLICIT_LAYER_PATH=$layers${VK_ADD_IMPLICIT_LAYER_PATH:+:$VK_ADD_IMPLICIT_LAYER_PATH}
unset DLSSNR_DISABLE VKLayer_DLSS5
shopt -s execfail
exec -- "$@"
status=$?
fail "$status" "dlsslop-run: could not execute $1 (status $status)"
