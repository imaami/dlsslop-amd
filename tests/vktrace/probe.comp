#version 450
layout(local_size_x = 64) in;
layout(constant_id = 0) const uint kScale = 2;
layout(set = 0, binding = 0) readonly buffer A { uint a[]; };
layout(set = 0, binding = 1) writeonly buffer B { uint b[]; };
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D img;
layout(push_constant) uniform P { uint add; uint w; } p;
void main() {
    uint i = gl_GlobalInvocationID.x;
    b[i] = a[i] * kScale + p.add;
    imageStore(img, ivec2(i % p.w, i / p.w), vec4(float(i & 255) / 255.0, float(p.add & 255) / 255.0, 0.5, 1.0));
}
