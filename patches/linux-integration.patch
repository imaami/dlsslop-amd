diff --git a/upstream-layer/layer_linux/src/storage_shader.h b/upstream-layer/layer_linux/src/storage_shader.h
new file mode 100644
index 0000000..47128c7
--- /dev/null
+++ b/upstream-layer/layer_linux/src/storage_shader.h
@@ -0,0 +1,77 @@
+#pragma once
+
+#include <cstdint>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace dlssnr {
+
+// The vendored DXC modules declare RWTexture2D<float4> as Rgba32f even though
+// their output views are RGBA8, BGRA8 or FP16. Make their write-only storage
+// images formatless before loading them. The device must enable
+// shaderStorageImageWriteWithoutFormat. This deliberately accepts only the
+// narrow shader shape we ship; a future storage read fails closed instead of
+// silently requiring shaderStorageImageReadWithoutFormat too.
+inline bool FormatlessStorageShader(const std::vector<char>& bytes,
+                                    std::vector<uint32_t>& words, std::string& reason) {
+    constexpr uint32_t kMagic = 0x07230203;
+    constexpr uint32_t kOpCapability = 17;
+    constexpr uint32_t kOpTypeImage = 25;
+    constexpr uint32_t kOpImageRead = 98;
+    constexpr uint32_t kOpImageWrite = 99;
+    constexpr uint32_t kOpImageTexelPointer = 60;
+    constexpr uint32_t kOpImageSparseRead = 320;
+    constexpr uint32_t kWriteWithoutFormat = 56;
+    const auto reject = [&](const char* text) {
+        reason = text;
+        words.clear();
+        return false;
+    };
+    if (bytes.size() < 5 * sizeof(uint32_t) || bytes.size() % sizeof(uint32_t))
+        return reject("invalid SPIR-V byte count");
+    words.resize(bytes.size() / sizeof(uint32_t));
+    std::memcpy(words.data(), bytes.data(), bytes.size());
+    if (words[0] != kMagic || words[4] != 0)
+        return reject("invalid SPIR-V header");
+
+    bool capability = false;
+    bool storage = false;
+    bool writes = false;
+    size_t capabilityEnd = 5;
+    for (size_t i = 5; i < words.size();) {
+        const uint32_t count = words[i] >> 16;
+        const uint32_t op = words[i] & 0xffffu;
+        if (!count || count > words.size() - i)
+            return reject("truncated SPIR-V instruction");
+        if (op == kOpCapability) {
+            if (count != 2) return reject("invalid OpCapability");
+            capability |= words[i + 1] == kWriteWithoutFormat;
+            if (i == capabilityEnd) capabilityEnd += count;
+        } else if (op == kOpTypeImage) {
+            if (count < 9) return reject("invalid OpTypeImage");
+            if (words[i + 7] == 2) {
+                // Dim2D, depth absent/unspecified, no array/MS, Unknown or the inherited Rgba32f.
+                if (words[i + 3] != 1 || words[i + 4] == 1 || words[i + 4] > 2 || words[i + 5] ||
+                    words[i + 6] || words[i + 8] > 1)
+                    return reject("unexpected storage image type");
+                words[i + 8] = 0;  // ImageFormatUnknown
+                storage = true;
+            }
+        } else if (op == kOpImageRead || op == kOpImageSparseRead || op == kOpImageTexelPointer) {
+            return reject("storage reads/atomics require a separate feature audit");
+        } else if (op == kOpImageWrite) {
+            writes = true;
+        }
+        i += count;
+    }
+    if (!storage || !writes) return reject("expected a write-only storage image shader");
+    if (!capability) {
+        words.insert(words.begin() + capabilityEnd,
+                     { (2u << 16) | kOpCapability, kWriteWithoutFormat });
+    }
+    reason.clear();
+    return true;
+}
+
+}  // namespace dlssnr
