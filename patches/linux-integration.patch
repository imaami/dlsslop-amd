new file mode 100644
index 0000000..5bcb3c6
--- /dev/null
+++ b/kernels/lds_barrier.h
@@ -0,0 +1,17 @@
+#ifndef DLSSLOP_LDS_BARRIER_H
+#define DLSSLOP_LDS_BARRIER_H
+
+// An AMDGPU execution barrier does not publish LDS writes or finish LDS reads.
+// In particular, gfx12 may signal its split barrier with DS operations still
+// outstanding. Release before arrival and acquire after waiting are required
+// when different waves exchange or reuse shared storage. Restrict these fences
+// to LDS so unrelated global loads do not need to drain at every rendezvous.
+// https://llvm.org/docs/AMDGPUUsage.html#execution-barriers
+__attribute__((device, always_inline, convergent)) inline void dlsslop_lds_barrier()
+{
+    __builtin_amdgcn_fence(3, "workgroup", "local"); // release
+    __builtin_amdgcn_s_barrier();
+    __builtin_amdgcn_fence(2, "workgroup", "local"); // acquire
+}
+
+#endif
