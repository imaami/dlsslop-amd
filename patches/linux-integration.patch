+ShmHeader* MapHeader(const char* path, bool create, bool writable, void** base, int* fdOut) {
+    const int flags = (writable ? O_RDWR : O_RDONLY) | O_CLOEXEC | O_NOFOLLOW | (create ? O_CREAT : 0);
